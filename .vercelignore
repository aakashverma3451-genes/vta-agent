# Hide the project's installable metadata so Vercel/uv does NOT try to install
# vta-agent[admet] (which needs the local `taxonagent` package, not on PyPI).
# The serverless function installs only api/requirements.txt (fastapi + pydantic)
# and imports the pure-Python vta source bundled via vercel.json includeFiles.
/pyproject.toml
/setup.py
/setup.cfg
/uv.lock
/poetry.lock
/requirements.txt
*.egg-info/
.python-version

# keep the upload slim
.git/
.venv/
venv/
taxonagent/
website/
docs/figures/
structures/
*.pdbqt
*.pdb
*.sdf
__pycache__/
*.pyc
outputs/**/*.log
outputs/phaseS/.cliff_dgcache.json
outputs/phase11/.mpro_30to1_dgcache.json
tests/
scripts/
